# 쿠팡 파트너스 Open API 키 (파트너스 > 링크생성 > API 에서 발급)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 파트너스 채널 ID (선택. 있으면 링크에 subId 로 붙어 채널별 수익 추적 가능)
COUPANG_SUB_ID=

# Claude API 키 (글쓰기 기능용)
ANTHROPIC_API_KEY=

# 아카이브 사이트 제목과 운영자 표기
SITE_TITLE=제품 영상 아카이브
SITE_OWNER=
# 프로필 링크 (강의 판매 / 오픈채팅 등 2차 수익 유도)
SITE_PROFILE_URL=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "n.usb.kr", "custom_domain": true }],
  "vars": {
    "SITE_NAME": "USB.KR",
    "SITE_URL": "https://usb.kr"
  },
  // 새 사이트 전용 저장소. generator/ 만 쓴다.
  "kv_namespaces": [
    { "binding": "POSTS", "id": "6f99a9ebdc554c868fdbcd821390b37c" }
  ],
  "env": {
    // 바인딩 없이 fixtures 로 도는 로컬 개발 환경
    "local": {
      "routes": [{ "pattern": "n.usb.kr", "custom_domain": true }],
  "vars": {
        "SITE_NAME": "USB.KR",
        "SITE_URL": "http://127.0.0.1:8787"
      }
    }
  }
}

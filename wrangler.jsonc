{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usb-kr",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": {
    "SITE_NAME": "USB.KR",
    "SITE_URL": "https://usb.kr"
  }
}

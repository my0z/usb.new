{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // 기존 usb.kr 워커의 와일드카드 경로보다 구체적이라 n.usb.kr 은 이 워커가 받는다.
  "workers_dev": true,
  "routes": [{ "pattern": "n.usb.kr/*", "zone_name": "usb.kr" }],
  "vars": {
    "SITE_NAME": "USB.KR",
    "SITE_URL": "https://usb.kr",
    // GA4 측정 ID. 비우면 태그를 안 넣는다.
    "GA_ID": ""
  },
  // 새 사이트 전용 저장소. generator/ 만 쓴다.
  "kv_namespaces": [
    { "binding": "POSTS", "id": "6f99a9ebdc554c868fdbcd821390b37c" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "new-usb-db", "database_id": "cc589b56-d347-42d5-81be-264c6bf6c576" }
  ],
  "env": {
    // 바인딩 없이 fixtures 로 도는 로컬 개발 환경
    "local": {
      "vars": {
        "SITE_NAME": "USB.KR",
        "SITE_URL": "http://127.0.0.1:8787"
      }
    }
  }
}

# 여러 플랫폼에서 공통으로 참조하는 공개 영상 URL
# 인스타그램 스레드 틱톡은 로컬 파일을 직접 받지 않고 공개 URL을 pull 방식으로 가져갑니다
VIDEO_PUBLIC_URL=

# YouTube Data API v3 (OAuth2 클라이언트 필요)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# Facebook Graph API
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Graph API (비즈니스/크리에이터 계정 + 연결된 페이지 필요)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Threads API
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=

# Bluesky (AT Protocol)
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

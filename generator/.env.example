# 쿠팡 파트너스 (파트너스 → 링크 생성 → API 키)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Cloudflare — 토큰에 "Workers KV Storage: Edit" 권한이 있어야 한다
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=709dcc6af36c8ee7b6d3d99e7a9fe422
KV_NAMESPACE_ID=6f99a9ebdc554c868fdbcd821390b37c

# Ollama (VM 에서 무료로 돈다)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:7.8b

# 권장 — 있으면 Groq 70B 를 먼저 쓰고 Ollama 는 예비로 돈다 (console.groq.com · 무료)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 선택 — 제품 홍보 영상 검색 (Google Cloud 콘솔 → YouTube Data API v3 키 · 무료)
YOUTUBE_API_KEY=

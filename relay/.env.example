# 이 relay는 이 프로젝트(usbnew-kiwoom-screener) 전용 인스턴스로 별도 VM/프로세스에서 돌리세요.
# 다른 워커가 쓰던 값(RELAY_SECRET, WORKER_URL, 포트 등)을 그대로 재사용하면 다시 공유 상태가 됩니다.

PORT=8787

# 이 relay 인스턴스만 아는 새 값으로 발급 (예: openssl rand -hex 32)
RELAY_SECRET=

# 이 relay가 붙을 "이 워커" 전용 주소. 다른 프로젝트의 workers.dev 도메인을 넣지 말 것.
WORKER_URL=https://usbnew-kiwoom-screener.<your-subdomain>.workers.dev

# 키움 관리용 API 호출 인증 - Worker의 ADMIN_KEY 시크릿과 동일한 값
ADMIN_KEY=

# 실전투자 앱키/시크릿 (웹소켓 실시간 시세 + REST 중계에 사용)
KIWOOM_APP_KEY_REAL=
KIWOOM_APP_SECRET_REAL=

# 감시할 조건검색식 번호 (선택, 비워두면 조건검색 실시간 기능 비활성화)
KIWOOM_CONDITION_SEQ=
